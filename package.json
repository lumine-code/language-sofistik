{
  "name": "language-sofistik",
  "author": "lumine-code",
  "description": "Syntax highlighting for SOFiSTiK structural analysis software.",
  "repository": "https://github.com/lumine-code/language-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/language-sofistik/issues"
  },
  "keywords": [
    "cadinp",
    "structural",
    "fem",
    "dat",
    "finite-element"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../language-sofistik/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "sofistik.keywords": {
      "versions": {
        "1.0.0": "provideSofistikKeywords"
      }
    }
  },
  "grammars": [
    "grammars/sofistik.json",
    "grammars/sofistik-raw.json",
    "grammars/sofistik-def.json"
  ],
  "configSchema": {
    "version": {
      "title": "SOFiSTiK version",
      "description": "SOFiSTiK version for keyword service (autocomplete). Use 'Auto detect' to detect from file content or sofistik.def.",
      "type": "string",
      "enum": [
        "Auto",
        "2026",
        "2025",
        "2024",
        "2023",
        "2022",
        "2020",
        "2018"
      ],
      "default": "Auto"
    },
    "language": {
      "title": "Language",
      "description": "Language for SOFiSTiK keyword service.",
      "type": "string",
      "enum": [
        "English",
        "German"
      ],
      "default": "English"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
